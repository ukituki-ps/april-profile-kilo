{
  "name": "april-service-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ds:prepare": "sh ./scripts/ds-prepare.sh",
    "predev": "npm run ds:prepare",
    "prebuild": "npm run ds:prepare",
    "prelint": "npm run ds:prepare",
    "pretest": "npm run ds:prepare",
    "dev": "vite",
    "build:app": "tsc --noEmit && vite build",
    "build": "npm run build:app && npm run build -w @april/profile-ui",
    "lint:app": "tsc --noEmit",
    "lint": "npm run lint:app && npm run lint -w @april/profile-ui",
    "test:app": "vitest run",
    "test": "npm run test:app && npm run test -w @april/profile-ui",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@april/profile-ui": "file:./packages/profile-ui",
    "@april/tokens": "file:vendor/ds-packs/april-tokens-0.1.5.tgz",
    "@april/ui": "file:vendor/ds-packs/april-ui-0.1.5.tgz",
    "@ukituki-ps/april-tokens": "file:vendor/ds-packs/april-tokens-0.1.5.tgz",
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^7.17.8",
    "@xyflow/react": "^12.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^24.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
