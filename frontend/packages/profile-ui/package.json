{
  "name": "@april/profile-ui",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:api": "openapi --input ../../../openapi/openapi.yaml --output ./src/generated --client fetch --useUnionTypes",
    "build": "npm run generate:api && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^7.17.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^24.1.3",
    "msw": "^2.11.5",
    "openapi-typescript-codegen": "^0.29.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
