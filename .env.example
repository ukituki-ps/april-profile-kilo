# Скопируйте в `.env` и при необходимости измените (не коммитить `.env` с секретами).
# Docker Compose подхватывает переменные из `.env` в каталоге проекта.

# Опционально: имя сервиса для логов и документации.
# SERVICE_NAME=april_template

# Публичный базовый URL API (подставьте свой хост после деплоя).
# PUBLIC_API_BASE_URL=https://dev.example.com/api

# Порт HTTP для Nginx (статика Docusaurus + OpenAPI + Swagger UI на хосте).
DOCS_HTTP_PORT=8080

# Порт Structurizr Lite на хосте (модель C4).
STRUCTURIZR_HTTP_PORT=8091

# --- Docker image tags for compose/deploy ---
# Для dev-деплоя используйте SHA коммита в IMAGE_TAG_BACKEND (обычно через images.env).
BACKEND_IMAGE_REPO=ghcr.io/ukituki-ps/april-profile-backend
IMAGE_TAG_BACKEND=local
# Публикация backend на хосте (контейнер 8080). 18081 выбран как менее конфликтный дефолт для dev-стенда.
BACKEND_HTTP_PORT=18081

# --- Backend / PostgreSQL (локально) ---
# Поднять БД и Redis: docker compose --profile db up -d postgres redis
# POSTGRES_USER=april
# POSTGRES_PASSWORD=april
# POSTGRES_DB=april_profile
# POSTGRES_PORT=5432
# Строка подключения для Atlas и приложения (пример для дефолтов выше).
# На dev/stage: задать в серверном .env — тогда deploy.sh применит миграции через scripts/run-migrations.sh.
# DATABASE_URL=postgres://april:april@127.0.0.1:5432/april_profile?sslmode=disable
# REDIS_PORT=6379
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# READINESS_TIMEOUT=3s
# Временный флаг для dev без Redis (по умолчанию строгая проверка Redis в /readyz):
# READYZ_ALLOW_WITHOUT_REDIS=false

# --- Asynq worker (`cmd/april-worker`, сервис `worker` в compose с профилем db) ---
# Те же DATABASE_URL и Redis, что у API; Keycloak не требуется.
# ASYNQ_CONCURRENCY=4
# OUTBOX_BATCH_SIZE=32
# ASYNQ_PING_INTERVAL=30s
# ASYNQ_OUTBOX_INTERVAL=15s

# --- Backend HTTP (фаза 1) ---
# HTTP_LISTEN_ADDR=:8080

# --- Keycloak JWT (backend; задача 005) ---
# Координаты стенда, discovery, JWKS, типичные ошибки — docs/keycloak-stand-coordinates.md
#
# Пример: BASE=http://192.168.1.42:8080/auth  realm=april  (подставьте фактические хост/realm)
# KEYCLOAK_JWKS_URL=http://192.168.1.42:8080/auth/realms/april/protocol/openid-connect/certs
# KEYCLOAK_ISSUER=http://192.168.1.42:8080/auth/realms/april
# KEYCLOAK_AUDIENCE=april-profile-api
# Имя claim с tenant (mapper в Keycloak; по умолчанию tenant_id):
# KEYCLOAK_TENANT_CLAIM=tenant_id
#
# Роль realm для админ-эндпоинтов /v1/admin/* (merge, конфликты). Пусто — не проверять роль (только для локальной отладки).
# KEYCLOAK_ADMIN_REALM_ROLE=april-profile-admin
#
# ABAC: фильтрация полей в GET профиля по сегментам и realm-ролям из JWT (realm_access.roles).
# JSON: объект «имя сегмента» -> массив имён realm-ролей Keycloak. Пусто — фильтрация отключена.
# Сегмент «default» — корневые скалярные поля документа; именованные вложенные объекты — сегмент = ключ верхнего уровня.
# Пример (одна строка или многострочный JSON в .env по правилам вашего окружения):
# ABAC_SEGMENT_ACCESS_JSON={"default":["april-profile-reader"],"hr":["april-profile-reader"],"security":["april-profile-security"]}
#
# Устаревшие имена (если в коде ещё встречаются — свести к KEYCLOAK_* выше):
# KEYCLOAK_ISSUER_BASE_URL=...
# APRIL_PROFILE_JWT_AUDIENCE=...
